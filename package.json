{
  "name": "academix",
  "version": "1.0.0",
  "description": "AcademiX: High-Concurrency Course Registration & Academic Management System with ACID Row-Locking (ADBMS Project)",
  "scripts": {
    "start": "node server/server.js",
    "build": "cd client && npm install && npm run build && cd ../server && npm install",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:preview": "cd client && npm run preview",
    "db:init": "node database/init.js",
    "db:setup": "powershell -ExecutionPolicy Bypass -File database/setup_db.ps1"
  },
  "keywords": [
    "postgresql",
    "adbms",
    "course-registration",
    "acid-transactions",
    "react",
    "express"
  ],
  "author": "ADBMS Project Team",
  "license": "ISC"
}

